# 3legant Storefront Environment Variables Blueprint
# Copy this file to .env.local and populate with your sandbox credentials.
# DO NOT commit .env.local to Git (.env* is in .gitignore).

# ==========================================
# 1. Supabase (Database, Auth, Storage, RLS)
# ==========================================
# Found in: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==========================================
# 2. Google OAuth (Configured in Supabase)
# ==========================================
# Setup in: Google Cloud Console > APIs & Services > Credentials
# Configure in: Supabase Dashboard > Authentication > Providers > Google
# Note: Add callback URL in Google Console:
# https://<your-project-id>.supabase.co/auth/v1/callback
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id

# ==========================================
# 3. Paystack Sandbox (Payments)
# ==========================================
# Found in: Paystack Dashboard > Settings > API Keys & Webhooks (Test mode)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_PAYSTACK_CURRENCY=NGN

# ==========================================
# 4. Mailgun (Transactional & Order Emails)
# ==========================================
# Found in: Mailgun Dashboard > Sending > Domains / API Security
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_DOMAIN=your-mailgun-domain.com
MAILGUN_REGION=us
MAILGUN_SENDER="3legant <orders@yourdomain.com>"

# If using Mailgun SMTP for Supabase Auth identity emails:
# Supabase Dashboard > Authentication > SMTP Settings:
# Host: smtp.mailgun.org (or smtp.eu.mailgun.org)
# Port: 587
# User: postmaster@your-mailgun-domain.com
# Password: your-smtp-password
